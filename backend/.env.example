# Environment Variables for Job Portal
# IMPORTANT: Copy this file to .env and add your real credentials
# NEVER commit .env to version control

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=job_portal

# Runtime
PORT=3000
NODE_ENV=development

# CORS (comma-separated local development ports)
CORS_ORIGINS=http://localhost:3001,http://localhost:8080,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Email Configuration (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=your_gmail_address@gmail.com
ADMIN_EMAIL=your_admin_email@gmail.com

# OAuth Configuration (Optional - social login)
# Get credentials from provider developer dashboards
# Redirect URLs:
#   Google   -> http://localhost:3000/api/auth/google/callback
#   LinkedIn -> http://localhost:3000/api/auth/linkedin/callback
OAUTH_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# AI Chat Configuration (Free Hugging Face Model)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# Payment Configuration (Mock for development)
USE_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=your_stripe_secret_key_here_optional

# Auto-approval settings (optional)
AUTO_APPROVE_REVIEWS=false
