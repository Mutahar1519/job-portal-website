# Environment Variables for Job Portal Backend
# IMPORTANT: Copy this file to .env and add your real credentials
# NEVER commit .env to version control

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=job_portal

# Runtime
PORT=3000
NODE_ENV=development

# Authentication - REQUIRED for production
# Generate a secure random string: openssl rand -hex 32
JWT_SECRET=your_super_secret_random_string_here_change_this_in_production

# CORS (comma-separated list of allowed frontend origins)
# Example for production: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3001,http://localhost:8080,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

