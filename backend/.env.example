# Environment Variables for Job Portal Backend

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=job_portal

# Runtime
PORT=3000
NODE_ENV=development

# CORS (comma-separated list of allowed frontend origins)
# Example for production: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3001,http://localhost:8080,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# JWT Secret (Generate a secure random string)
JWT_SECRET=your_secure_jwt_secret_here

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
ADMIN_EMAIL=admin@yourdomain.com

# OAuth Configuration (Optional - social login)
# Set OAUTH_BASE_URL to your backend public URL in production.
OAUTH_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# AI Chat Configuration (Free Hugging Face Model)
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# Payment Configuration
USE_MOCK_PAYMENTS=true

# Auto-approval settings
AUTO_APPROVE_JOBS=false